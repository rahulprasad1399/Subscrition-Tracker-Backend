########################################

# Angular build output
dist/
dist-out/
out-tsc/

# Node modules
node_modules/

# Angular cache
.angular/

# Environment files
src/environments/environment.ts
src/environments/environment.prod.ts

# Logs
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log

# Cache / temp
*.tsbuildinfo
/.sass-cache
/.npm
/.cache
/tmp
*.tmp

########################################
# OS Specific
########################################

# Windows overrides
Thumbs.db
Desktop.ini

# macOS overrides
.DS_Store
.AppleDouble
.LSOverride

########################################
# IDE / Editor
########################################

# JetBrains Rider
.idea/
*.iml

# VS Code
.vscode/*
!.vscode/settings.json
